<?xml version="1.0"?>
<package format="3">
  <name>openarm_sim_bringup</name>
  <version>0.1.0</version>
  <description>Launch and visualization files for OpenArm Isaac safety validation.</description>
  <maintainer email="openarm-sim@example.invalid">OpenArm simulation maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>openarm_description</exec_depend>
  <exec_depend>openarm_bimanual_moveit_config</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>openarm_isaac_bridge</exec_depend>
  <exec_depend>openarm_dynamic_avoidance</exec_depend>
  <exec_depend>openarm_perception_adapter</exec_depend>
  <exec_depend>openarm_safety_bridge</exec_depend>
  <exec_depend>openarm_sim_evaluator</exec_depend>
  <exec_depend>openarm_sorting_task</exec_depend>
  <exec_depend>hand_obstacle_controller</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>

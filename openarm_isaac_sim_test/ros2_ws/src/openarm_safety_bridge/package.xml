<?xml version="1.0"?>
<package format="3">
  <name>openarm_safety_bridge</name>
  <version>0.1.0</version>
  <description>Mode-isolated dynamic obstacle and safety supervisor bridge for OpenArm.</description>
  <maintainer email="openarm-sim@example.invalid">OpenArm simulation maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>


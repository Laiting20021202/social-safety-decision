<?xml version="1.0"?>
<package format="3">
  <name>openarm_isaac_bridge</name>
  <version>0.1.0</version>
  <description>Standard ROS 2 RGB-D and trajectory bridge for the OpenArm Isaac simulation.</description>
  <maintainer email="openarm-sim@example.invalid">OpenArm simulation maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>


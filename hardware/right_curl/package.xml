<?xml version="1.0"?>
<package format="3">
  <name>openarm_right_curl</name>
  <version>0.1.0</version>
  <description>Right elbow commissioning with OpenArm v1.0 encoder feedback.</description>
  <maintainer email="hrclab@localhost.localdomain">HRCLab</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>hardware_interface</depend>

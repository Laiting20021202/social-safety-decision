diff --git a/config/arm/v10/control_gains.yaml b/config/arm/v10/control_gains.yaml
index 7364f59..8a3524e 100644
--- a/config/arm/v10/control_gains.yaml
+++ b/config/arm/v10/control_gains.yaml
@@ -13,29 +13,38 @@
 # limitations under the License.
 
 joint1:
+  # Keep the shared/right-arm stiffness at 70. Test left J1 at 80 with
+  # unchanged damping; compare tracking error at the same pose before tuning further.
   kp: 70.0
-  kd: 2.75
+  left_kp: 80.0
+  kd: 3.5
 
 joint2:
-  kp: 70.0
-  kd: 2.5
+  kp: 50.0
+  kd: 3.5
 
 joint3:
-  kp: 70.0
-  kd: 2.0
+  kp: 50.0
+  kd: 3.0
 
 joint4:
+  # Loaded wrist needs the driver's original stiffness to stay within the
+  # controller's 0.05 rad goal tolerance in the gravity-test pose.
   kp: 60.0
-  kd: 2.0
+  kd: 3.0
 
 joint5:
   kp: 10.0
-  kd: 0.7
+  kd: 1.2
 
 joint6:
-  kp: 10.0
-  kd: 0.6
+  # Increase wrist holding stiffness incrementally.  At kp=10 the latest
+  # stationary sample retained about 0.024 rad (1.37 deg) of J6 error.
+  kp: 15.0
+  kd: 1.0
 
 joint7:
+  # Restore the driver's original wrist stiffness; the camera/cable payload
+  # otherwise leaves this joint too close to the 0.05 rad goal tolerance.
   kp: 10.0
-  kd: 0.5
+  kd: 0.8
diff --git a/urdf/ee/openarm_hand.xacro b/urdf/ee/openarm_hand.xacro

--- a/urdf/ee/openarm_hand.xacro
+++ b/urdf/ee/openarm_hand.xacro
@@ -32,6 +32,16 @@
       <child link="${ee_prefix}hand_tcp" />
     </joint>
 
+    <!-- Physical fingertip center, defined directly from the hand so target
+         motion and calibration do not depend on the compatibility TCP. -->
+    <link name="${ee_prefix}fingertip_center" />
+
+    <joint name="${ee_prefix}fingertip_center_joint" type="fixed">
+      <origin xyz="0 0 0.08" rpy="0 0 0" />
+      <parent link="${ee_prefix}hand" />
+      <child link="${ee_prefix}fingertip_center" />
+    </joint>
+
     <link name="${ee_prefix}left_finger">
       <visual name="${ee_prefix}left_finger_visual">
         <xacro:openarm-ee-kinematics-link config="${ee_kinematics_link}" name="left_finger" />
